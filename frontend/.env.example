# Frontend environment configuration (Vite).
#
# Copy to .env.local and adjust. Vite only inlines variables prefixed with VITE_,
# and only `import.meta.env.VITE_*` is available in a built bundle.
#
# ALL of these are optional. With no Firebase configuration the web app runs in
# guest mode: you can play rounds, read chat and view the leaderboard, and the UI
# states plainly that you are not signed in. Protected actions (registering a
# username, claiming the daily bonus, sending chat, scoring a round) require an
# account, so a guest does not accumulate a score.

# Base URL of the API. Leave EMPTY for local development: the Vite dev server
# proxies /api and /socket.io to http://localhost:5000 (see vite.config.js).
# Set it at build time when the API is served from a different origin, e.g.
#   VITE_API_URL=https://api.example.com npm run build
VITE_API_URL=

# --- Firebase Authentication (web app config) ---------------------------------
# From Firebase console -> Project settings -> Your apps -> Web app -> SDK setup
# and configuration. These values are public client identifiers, not secrets; the
# security boundary is your Firebase Auth settings and firestore.rules.
#
# The backend must be configured with the SAME Firebase project
# (FIREBASE_PROJECT_ID, and a service account for the Admin SDK) or every bearer
# token will be rejected. See backend/.env.example.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Note: VITE_FIREBASE_API_KEY and VITE_FIREBASE_PROJECT_ID are the two required
# values. With them absent the app is in guest mode; with them present but wrong,
# the app still renders and reports the auth error instead of failing to load.
#
# Enable "Email/Password" under Authentication -> Sign-in method, or sign-up and
# sign-in will fail with auth/operation-not-allowed.
