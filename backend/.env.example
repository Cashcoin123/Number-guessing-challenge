# Backend environment configuration
# Copy to .env and adjust. Never commit the real .env file.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# --- Authentication -----------------------------------------------------------
# The API is fail-closed: every protected route requires a valid Firebase ID
# token. ENABLE_AUTH=true documents the production posture; the old fail-open
# behaviour (bypass whenever ENABLE_AUTH was not exactly "true") has been removed.
ENABLE_AUTH=true
# ALLOW_DEV_AUTH enables the local development identity bypass and is honoured
# ONLY when NODE_ENV is not "production", so it can never take effect in
# production. Set it to false to exercise the real Firebase token path locally.
# This template targets local development (NODE_ENV=development) so the web app
# works out of the box after `cp .env.example .env`.
ALLOW_DEV_AUTH=true

# --- Storage backend ----------------------------------------------------------
USE_FIREBASE=false
USE_POSTGRES=false

# Postgres (when USE_POSTGRES=true)
DATABASE_URL=postgres://user:password@localhost:5432/number_guessing

# Firebase (when USE_FIREBASE=true)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# --- Game rounds --------------------------------------------------------------
# A round is held in memory until it is finished, hits its hard 30 minute limit, or
# has been idle this long (milliseconds). Idle rounds are reclaimed before the
# store ever refuses a new round, so a player who steps away does not hold a slot
# forever. Lower it to reclaim abandoned rounds faster on a small instance.
ROUND_IDLE_TTL_MS=1800000

# --- Abuse controls -----------------------------------------------------------
# Per-source admission control for POST /api/game/start, which is intentionally
# open to guests. One source may create at most ROUNDS_RATE_MAX rounds per
# ROUNDS_RATE_WINDOW_MS window; further attempts get a retryable 429. The key
# space is bounded, so one source cannot multiply its budget by respelling its
# address: a trailing port is ignored (bracketed or not), case/whitespace/zone
# suffix/leading-zero octets are normalised, ::ffff:IPv4 counts as the same
# source as the plain IPv4 address, IPv6 sources are budgeted per /64 prefix, and
# text that is not a valid address shares ONE bucket instead of keying on its raw
# text. This bounds the single-source flood that could otherwise fill the capped
# round store and make NEW rounds fail for everyone (ISSUE-23 residual). Honest
# play (a few rounds a minute) is unaffected.
#
# This does NOT bound a caller that presents a genuinely different valid address
# each request (real source-address rotation, or a proxy that forwards a
# client-controlled address); authenticating the endpoint is the durable fix for
# that and is intentionally not done because guests must be able to play.
ROUNDS_RATE_WINDOW_MS=60000
ROUNDS_RATE_MAX=30

# Trust X-Forwarded-For for rate-limit keying. Set to true ONLY when the app runs
# behind a trusted reverse proxy that overwrites the header; otherwise a caller
# could spoof its own bucket and evade the limit. Off by default.
TRUST_PROXY=false
